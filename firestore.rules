rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /system_test/{testId} {
      allow read, write: if true;
    }
    match /users/{id} {
      allow read, write: if true;
    }
    match /students/{id} {
      allow read, write: if true;
    }
    match /classes/{id} {
      allow read, write: if true;
    }
    match /subjects/{id} {
      allow read, write: if true;
    }
    match /academic_terms/{id} {
      allow read, write: if true;
    }
    match /schedules/{id} {
      allow read, write: if true;
    }
    match /teaching_assignments/{id} {
      allow read, write: if true;
    }
    match /student_attendance/{id} {
      allow read, write: if true;
    }
    match /teacher_attendance/{id} {
      allow read, write: if true;
    }
    match /grades/{id} {
      allow read, write: if true;
    }
    match /laporan_harian/{id} {
      allow read, write: if true;
    }
    match /ibadah_siswa/{id} {
      allow read, write: if true;
    }
    match /ibadah_guru/{id} {
      allow read, write: if true;
    }
    match /pemantauan_pagi/{id} {
      allow read, write: if true;
    }
    match /kinerja_staf/{id} {
      allow read, write: if true;
    }
    match /sarpras/{id} {
      allow read, write: if true;
    }
    match /leave_requests/{id} {
      allow read, write: if true;
    }
    match /announcements/{id} {
      allow read, write: if true;
    }
    match /notifications/{id} {
      allow read, write: if true;
    }
    match /cbt_exams/{id} {
      allow read, write: if true;
    }
    match /cbt_questions/{id} {
      allow read, write: if true;
    }
    match /cbt_submissions/{id} {
      allow read, write: if true;
    }
    match /materi_ajar/{id} {
      allow read, write: if true;
    }
    match /materi_objectives/{id} {
      allow read, write: if true;
    }
    match /nilai_sikap/{id} {
      allow read, write: if true;
    }
    match /agenda/{id} {
      allow read, write: if true;
    }
    match /bk_cases/{id} {
      allow read, write: if true;
    }
    match /academic_history/{id} {
      allow read, write: if true;
    }
    match /key_value_store/{id} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
